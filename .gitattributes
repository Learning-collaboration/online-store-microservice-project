.env* text eol=lf

# Keep Windows-specific scripts in CRLF so they execute properly on Windows
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Prevent Git from modifying line endings in binary files
*.png binary
*.jpg binary
*.jpeg binary
