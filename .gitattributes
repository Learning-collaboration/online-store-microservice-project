# Set default behavior to automatically normalize line endings to LF
* text=auto eol=lf

# Explicitly enforce LF for Linux scripts, containers, and IaC configs
*.sh text eol=lf
*.bash text eol=lf
*.zsh text eol=lf
Dockerfile* text eol=lf
*.dockerfile text eol=lf
docker-compose*.yml text eol=lf
docker-compose*.yaml text eol=lf
*.tf text eol=lf
*.tfvars text eol=lf
*.hcl text eol=lf

# Common code and config formats
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.md text eol=lf
*.py text eol=lf
*.go text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.sql text eol=lf
*.java text eol=lf
