#!/bin/sh
commit_msg_file="$1"
commit_msg=$(head -n 1 "$commit_msg_file")

# Allow Git-generated merge/revert commits
if echo "$commit_msg" | grep -qE "^(Merge|Revert) "; then
  exit 0
fi

# Enforce Conventional Commits: <type>[optional scope][!]: <description>
pattern="^(feat|fix|chore|docs|refactor|ci|build|perf|test|style|revert)(\([a-zA-Z0-9_-]+\))?!?: .{1,72}$"

if ! echo "$commit_msg" | grep -qE "$pattern"; then
  echo "ERROR: Invalid commit message format."
  echo "Received: '$commit_msg'"
  echo "Expected: <type>[optional scope]: <imperative description (max 72 chars)>"
  echo "Allowed types: feat, fix, chore, docs, refactor, ci, build, perf, test, style, revert"
  exit 1
fi